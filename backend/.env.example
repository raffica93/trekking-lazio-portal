# Gemini 3.5 Flash for CAI calendar extraction. Same name as the GitHub Actions secret.
GEMINI_KEY=
SUPABASE_URL=https://your-project.supabase.co
# Server-only key. Never copy this value into the frontend or a public file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Imports are deliberately private by default. Use published only after review.
SUPABASE_IMPORT_STATUS=draft
